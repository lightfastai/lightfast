{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["@biomejs/biome"]
    },
    "apps/email": {
      "ignoreDependencies": ["@react-email/ui", "@repo/email"]
    },
    "api/app": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/desktop": {
      "entry": ["src/**/*.test.ts", "scripts/**/*.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    },
    "apps/example": {
      "entry": [
        "src/router.tsx",
        "src/start.ts",
        "src/routes/**/*.tsx",
        "src/**/*.test.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/mcp": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@modelcontextprotocol/sdk"]
    },
    "apps/remotion": {
      "entry": ["src/index.ts", "remotion.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["css-loader", "postcss-loader", "style-loader"]
    },
    "core/*": {
      "entry": ["src/{bin,index}.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "core/mcp": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@modelcontextprotocol/sdk"]
    },
    "db/app": {
      "entry": ["src/index.ts", "src/drizzle.config.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/email": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@react-email/render"]
    },
    "packages/remotion": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui-v2": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tw-animate-css"]
    },
    "vendor/*": {
      "project": ["src/**/*.ts"],
      "drizzle": false
    },
    "internal/typescript": {
      "entry": ["base.json"]
    },
    "internal/vitest-config": {},
    "vendor/db": {
      "entry": ["src/{env,index}.ts"],
      "project": ["src/**/*.ts"],
      "drizzle": false
    }
  },
  "ignoreIssues": {
    "packages/api-contract/src/mcp.ts": ["types"],
    "packages/api-contract/src/schemas/signals.ts": ["duplicates"],
    "packages/email/src/templates/*.tsx": ["duplicates"]
  },
  "ignoreDependencies": ["postcss", "tailwindcss", "@tailwindcss/postcss"]
}
