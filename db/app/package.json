{
  "name": "@db/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "license": "Apache-2.0",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "db:generate": "drizzle-kit generate --config=./src/drizzle.config.ts",
    "db:push": "pnpm with-env drizzle-kit push --config=./src/drizzle.config.ts",
    "db:studio": "portless run --name db.lightfast sh -c 'pnpm with-env drizzle-kit studio --config=./src/drizzle.config.ts --host \"$HOST\" --port \"$PORT\"'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ./.env.overrides.local -e ./.env.local --"
  },
  "dependencies": {
    "@vendor/db": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "^0.31.10",
    "portless": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
