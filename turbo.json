{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/**/__tests__/**",
        "!src/**/*.test.*",
        "!src/**/*.spec.*",
        "!vitest.config.ts"
      ],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#check": {
      "inputs": ["$TURBO_DEFAULT$", "biome.jsonc"],
      "outputs": []
    },
    "//#knip": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "knip.json",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/**/__tests__/**",
        "!src/**/*.test.*",
        "!src/**/*.spec.*",
        "!vitest.config.ts"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vitest.config.ts", "tsconfig.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"],
      "outputs": [".cache/tsbuildinfo.json"],
      "env": []
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "render:all": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui": {
      "cache": false,
      "interactive": true
    }
  },
  "globalEnv": ["CI"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",
    "npm_lifecycle_event"
  ],
  "boundaries": {
    "implicitDependencies": ["~"],
    "tags": {
      "vendor": {
        "dependencies": { "deny": ["packages", "data", "api", "app"] }
      },
      "internal": {
        "dependencies": {
          "deny": ["vendor", "packages", "data", "api", "app", "core"]
        }
      },
      "app": {
        "dependents": {
          "deny": ["vendor", "packages", "data", "api", "core", "internal"]
        }
      }
    }
  }
}
