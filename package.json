{
  "name": "@lightfastai/workspace",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.1.3"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "build:example": "turbo run build -F @lightfast/example",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "portless proxy start && turbo run dev -F @lightfast/example -F @lightfast/storybook --continue",
    "brain": "turbo run eval",
    "e2e": "pnpm --filter @lightfast/e2e test",
    "e2e:decisions": "pnpm --filter @lightfast/e2e decisions:real-clerk",
    "e2e:github-setup": "pnpm --filter @lightfast/e2e github:setup:real-clerk",
    "e2e:sdk": "pnpm --filter @lightfast/e2e sdk",
    "e2e:signals": "pnpm --filter @lightfast/e2e signals",
    "check": "npx ultracite@latest check",
    "fix": "npx ultracite@latest fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "test": "SKIP_ENV_VALIDATION=true turbo run test",
    "typecheck": "SKIP_ENV_VALIDATION=true turbo run typecheck",
    "verify:public-api": "SKIP_ENV_VALIDATION=true turbo run typecheck test --filter=@repo/api-contract --filter=@api/app --filter=lightfast --filter=@lightfastai/mcp --filter=@repo/mcp-tools --filter=@vendor/mcp --continue --summarize",
    "ui": "pnpm --filter @repo/ui ui",
    "vercel:link": "pnpm dlx vercel@latest link --repo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish:sdk-mcp": "changeset publish",
    "remotion:studio": "pnpm --filter @lightfast/remotion studio",
    "remotion:render": "pnpm --filter @lightfast/remotion render:all",
    "db:generate": "pnpm --filter @db/app db:generate",
    "db:audit": "pnpm --filter @db/app db:audit",
    "db:push": "pnpm --filter @db/app db:push",
    "db:migrate": "pnpm --filter @db/app db:migrate",
    "db:studio": "pnpm --filter @db/app db:studio",
    "db:baseline": "pnpm --filter @db/app db:baseline",
    "entity-graph:simulated": "pnpm --filter @db/app entity-graph:simulated",
    "knip": "SKIP_ENV_VALIDATION=true knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@changesets/cli": "^2.31.0",
    "knip": "^6.4.1",
    "portless": "catalog:",
    "turbo": "2.9.14",
    "turbo-ignore": "2.9.14",
    "typescript": "^5.9.2",
    "ultracite": "7.6.0"
  }
}
