{
  "name": "@lightfastai/workspace",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.1.3"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "build:example": "turbo run build -F @lightfast/example",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "portless proxy start && turbo run dev -F @lightfast/example -F @lightfast/storybook --continue",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "test": "SKIP_ENV_VALIDATION=true turbo run test",
    "typecheck": "SKIP_ENV_VALIDATION=true turbo run typecheck",
    "verify:public-api": "SKIP_ENV_VALIDATION=true turbo run typecheck test --filter=@repo/api-contract --filter=@api/app --filter=lightfast --filter=@lightfastai/cli --filter=@lightfastai/mcp --filter=@lightfast/mcp-local --filter=@repo/mcp-tools --filter=@vendor/mcp --continue --summarize",
    "ui": "turbo run ui --filter=@repo/ui",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish:sdk-mcp": "changeset publish",
    "remotion:studio": "turbo run studio --filter=@lightfast/remotion",
    "remotion:render": "turbo run render:all --filter=@lightfast/remotion",
    "db:generate": "turbo run db:generate --filter=@db/app",
    "db:push": "turbo run db:push --filter=@db/app",
    "db:studio": "turbo run db:studio --filter=@db/app",
    "knip": "SKIP_ENV_VALIDATION=true knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@changesets/cli": "^2.31.0",
    "knip": "^6.4.1",
    "portless": "catalog:",
    "turbo": "2.9.14",
    "typescript": "^5.9.2",
    "ultracite": "7.6.0"
  }
}
